{
  "name": "darkianmail-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted SMTP backend for the DarkianMail email frontend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0",
    "mailparser": "^3.7.1",
    "nanoid": "^5.1.5",
    "nodemailer": "^6.9.14",
    "postgres": "^3.4.5",
    "smtp-server": "^3.13.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.16",
    "@types/smtp-server": "^3.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
